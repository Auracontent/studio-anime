 "phrases": [
  {
   "text": "Zo\u00e9 tombe de son v\u00e9lo,",
   "s": 0.0,
   "e": 1.3
  },
  {
   "text": "encore une fois,",
   "s": 1.48,
   "e": 2.18
  },
  {
   "text": "devant toute l'\u00e9cole.",
   "s": 2.18,
   "e": 3.82
  },
  {
   "text": "Les autres roulent d\u00e9j\u00e0.",
   "s": 3.82,
   "e": 4.6
  },
  {
   "text": "Ils rient,",
   "s": 4.6,
   "e": 5.28
  },
  {
   "text": "et elle serre les poings.",
   "s": 5.28,
   "e": 7.18
  },
  {
   "text": "Alors,",
   "s": 7.18,
   "e": 7.28
  },
  {
   "text": "chaque soir,",
   "s": 7.28,
   "e": 7.66
  },
  {
   "text": "quand la cour est vide,",
   "s": 7.9,
   "e": 8.42
  },
  {
   "text": "elle recommence.",
   "s": 8.88,
   "e": 9.44
  },
  {
   "text": "Une chute.",
   "s": 9.92,
   "e": 10.3
  },
  {
   "text": "Deux chutes.",
   "s": 10.86,
   "e": 11.5
  },
  {
   "text": "Dix chutes,",
   "s": 12.04,
   "e": 12.68
  },
  {
   "text": "le genou rouge,",
   "s": 13.16,
   "e": 14.06
  },
  {
   "text": "la roue tordue.",
   "s": 14.24,
   "e": 15.0
  },
  {
   "text": "Son grand fr\u00e8re Malo la regarde par la fen\u00eatre.",
   "s": 15.78,
   "e": 17.42
  },
  {
   "text": "Lui aussi,",
   "s": 17.42,
   "e": 18.34
  },
  {
   "text": "il riait.",
   "s": 18.34,
   "e": 19.32
  },
  {
   "text": "Sauf que ce soir-l\u00e0,",
   "s": 19.32,
   "e": 20.48
  },
  {
   "text": "il descend.",
   "s": 20.48,
   "e": 20.84
  },
  {
   "text": "Il tient la selle et court derri\u00e8re elle.",
   "s": 21.62,
   "e": 23.74
  },
  {
   "text": "Il l\u00e2che.",
   "s": 24.52,
   "e": 25.22
  },
  {
   "text": "Zo\u00e9 roule seule,",
   "s": 26.02,
   "e": 27.78
  },
  {
   "text": "toute droite,",
   "s": 27.78,
   "e": 28.26
  },
  {
   "text": "le vent dans le visage,",
   "s": 29.04,
   "e": 30.22
  },
  {
   "text": "sans s'en rendre compte.",
   "s": 30.56,
   "e": 31.58
  },
  {
   "text": "Le lendemain,",
   "s": 31.58,
   "e": 33.24
  },
  {
   "text": "toute l'\u00e9cole la regarde passer.",
   "s": 33.24,
   "e": 34.82
  },
  {
   "text": "Plus personne ne rit.",
   "s": 34.82,
   "e": 35.6
  },
  {
   "text": "Tu sais ce que \u00e7a prouve ?",
   "s": 36.46,
   "e": 37.34
  },
  {
   "text": "On ne tombe pas parce qu'on est nul.",
   "s": 37.92,
   "e": 39.86
  },
  {
   "text": "On tombe pour apprendre.",
   "s": 39.86,
   "e": 40.78
  },
  {
   "text": "Alors,",
   "s": 41.68,
   "e": 41.82
  },
  {
   "text": "la prochaine fois que tu tombes,",
   "s": 41.82,
   "e": 42.74
  },
  {
   "text": "rel\u00e8ve-toi une fois de plus.",
   "s": 42.74,
   "e": 43.8
  }
 ]
