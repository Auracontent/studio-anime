 "phrases": [
  {
   "text": "Personne n'a trouv\u00e9 le poids de ce b\u0153uf.",
   "s": 0.0,
   "e": 1.54
  },
  {
   "text": "Mais la foule enti\u00e8re,",
   "s": 1.92,
   "e": 2.84
  },
  {
   "text": "si.",
   "s": 3.42,
   "e": 3.68
  },
  {
   "text": "Dans une foire anglaise,",
   "s": 4.78,
   "e": 5.64
  },
  {
   "text": "pr\u00e8s de huit cents visiteurs \u00e9crivent leur estimation sur un billet.",
   "s": 6.02,
   "e": 8.66
  },
  {
   "text": "Il y a des bouchers,",
   "s": 9.3,
   "e": 10.44
  },
  {
   "text": "des fermiers,",
   "s": 10.44,
   "e": 10.92
  },
  {
   "text": "et des gens qui n'ont jamais touch\u00e9 un b\u0153uf.",
   "s": 10.92,
   "e": 12.74
  },
  {
   "text": "Un savant,",
   "s": 13.52,
   "e": 14.24
  },
  {
   "text": "Francis Galton,",
   "s": 14.78,
   "e": 15.44
  },
  {
   "text": "ramasse les billets.",
   "s": 15.74,
   "e": 16.44
  },
  {
   "text": "Il est s\u00fbr que la foule va se tromper lourdement.",
   "s": 17.1,
   "e": 19.02
  },
  {
   "text": "Sauf que\u2026 il calcule le chiffre du milieu :",
   "s": 19.6,
   "e": 22.588
  },
  {
   "text": "mille deux cent sept livres.",
   "s": 22.588,
   "e": 24.14
  },
  {
   "text": "Le b\u0153uf,",
   "s": 24.7,
   "e": 25.52
  },
  {
   "text": "une fois pr\u00e9par\u00e9,",
   "s": 25.64,
   "e": 26.4
  },
  {
   "text": "p\u00e8se mille cent quatre-vingt-dix-huit livres.",
   "s": 26.82,
   "e": 28.38
  },
  {
   "text": "Moins d'un pour cent d'\u00e9cart.",
   "s": 29.04,
   "e": 30.96
  },
  {
   "text": "Chaque billet se trompait,",
   "s": 30.96,
   "e": 31.98
  },
  {
   "text": "mais les erreurs trop fortes et trop faibles s'annulaient.",
   "s": 32.26,
   "e": 34.88
  },
  {
   "text": "C'\u00e9tait en mil neuf cent six.",
   "s": 34.88,
   "e": 37.36
  },
  {
   "text": "Aucun visiteur n'avait la r\u00e9ponse,",
   "s": 37.36,
   "e": 38.82
  },
  {
   "text": "mais tous ensemble,",
   "s": 39.58,
   "e": 40.2
  },
  {
   "text": "ils l'avaient.",
   "s": 40.2,
   "e": 41.46
  }
 ]
