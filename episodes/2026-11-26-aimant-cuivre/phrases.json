 ],
 "phrases": [
  {
   "text": "Cet aimant tombe au ralenti dans ce tube\u2026 et rien ne le touche.",
   "s": 0.0,
   "e": 3.06
  },
  {
   "text": "Dans un tube en plastique,",
   "s": 3.92,
   "e": 4.76
  },
  {
   "text": "il tombe d'un coup.",
   "s": 4.8,
   "e": 5.32
  },
  {
   "text": "Dans le cuivre,",
   "s": 6.04,
   "e": 6.54
  },
  {
   "text": "il flotte presque,",
   "s": 6.86,
   "e": 7.5
  },
  {
   "text": "comme dans du miel.",
   "s": 7.9,
   "e": 8.46
  },
  {
   "text": "Pourtant,",
   "s": 9.42,
   "e": 9.72
  },
  {
   "text": "le cuivre n'attire pas les aimants.",
   "s": 9.78,
   "e": 10.8
  },
  {
   "text": "Essaie,",
   "s": 10.8,
   "e": 12.16
  },
  {
   "text": "il ne se passe rien.",
   "s": 12.16,
   "e": 12.74
  },
  {
   "text": "Alors qui le retient ?",
   "s": 13.74,
   "e": 15.94
  },
  {
   "text": "Un Parisien a trouv\u00e9 en mille huit cent cinquante-cinq.",
   "s": 15.94,
   "e": 18.28
  },
  {
   "text": "L\u00e9on Foucault,",
   "s": 18.28,
   "e": 18.94
  },
  {
   "text": "celui du pendule.",
   "s": 19.12,
   "e": 19.72
  },
  {
   "text": "Il fait tourner un disque de cuivre entre les p\u00f4les d'un aimant.",
   "s": 20.58,
   "e": 23.08
  },
  {
   "text": "D\u00e8s que l'aimant agit,",
   "s": 23.7,
   "e": 24.44
  },
  {
   "text": "le disque devient dur \u00e0 tourner\u2026 et il chauffe.",
   "s": 24.66,
   "e": 27.1
  },
  {
   "text": "Sauf que rien ne frotte le disque.",
   "s": 27.8,
   "e": 29.3
  },
  {
   "text": "En fait,",
   "s": 30.04,
   "e": 30.62
  },
  {
   "text": "un aimant qui bouge fait na\u00eetre de petits courants dans le cuivre.",
   "s": 30.84,
   "e": 33.54
  },
  {
   "text": "Ces courants fabriquent un autre aimant,",
   "s": 34.18,
   "e": 35.54
  },
  {
   "text": "qui repousse le premier.",
   "s": 35.54,
   "e": 36.7
  },
  {
   "text": "Plus l'aimant va vite,",
   "s": 37.78,
   "e": 38.42
  },
  {
   "text": "plus le frein est fort.",
   "s": 38.84,
   "e": 39.44
  },
  {
   "text": "Aujourd'hui,",
   "s": 39.44,
   "e": 41.16
  },
  {
   "text": "ces freins invisibles ralentissent des montagnes russes et certains trains,",
   "s": 41.16,
   "e": 44.52
  },
  {
   "text": "sans aucun frottement.",
   "s": 44.52,
   "e": 45.64
  },
  {
   "text": "Pas d'usure,",
   "s": 46.76,
   "e": 47.52
  },
  {
   "text": "pas de bruit,",
   "s": 47.52,
   "e": 47.86
  },
  {
   "text": "juste de la physique.",
   "s": 48.36,
   "e": 49.12
  },
  {
   "text": "Et dans le tube,",
   "s": 50.46,
   "e": 50.94
  },
  {
   "text": "l'aimant ressort enfin,",
   "s": 50.94,
   "e": 52.04
  },
  {
   "text": "tout doucement.",
   "s": 52.8,
   "e": 53.32
  },
  {
   "text": "Il tombait au ralenti\u2026 et personne ne l'avait touch\u00e9.",
   "s": 53.32,
   "e": 57.68
  }
 ]
}