 "phrases": [
  {
   "text": "Le plus c\u00e9l\u00e8bre dessin d'une bombe m\u00e9di\u00e9vale\u2026 a \u00e9t\u00e9 ajout\u00e9 apr\u00e8s coup.",
   "s": 0.298,
   "e": 4.898
  },
  {
   "text": "Vers douze cent quatre-vingt-treize,",
   "s": 5.458,
   "e": 7.212
  },
  {
   "text": "le samoura\u00ef Suenaga fait peindre ses exploits contre les Mongols.",
   "s": 7.725,
   "e": 11.675
  },
  {
   "text": "Mais l'explosion, elle,",
   "s": 12.375,
   "e": 13.319
  },
  {
   "text": "n'a \u00e9t\u00e9 rajout\u00e9e que plus de quatre si\u00e8cles plus tard.",
   "s": 14.303,
   "e": 16.644
  },
  {
   "text": "Alors,",
   "s": 17.096,
   "e": 18.328
  },
  {
   "text": "ces bombes existaient-elles vraiment ?",
   "s": 19.513,
   "e": 23.582
  },
  {
   "text": "Sauf que\u2026 en deux mille onze,",
   "s": 24.418,
   "e": 25.482
  },
  {
   "text": "des plongeurs fouillent le fond de la mer,",
   "s": 25.782,
   "e": 28.028
  },
  {
   "text": "\u00e0 Takashima.",
   "s": 28.829,
   "e": 30.729
  },
  {
   "text": "Sous un m\u00e8tre de sable dort un navire mongol,",
   "s": 31.636,
   "e": 33.452
  },
  {
   "text": "coul\u00e9 en douze cent quatre-vingt-un.",
   "s": 33.924,
   "e": 35.486
  },
  {
   "text": "Dedans,",
   "s": 35.766,
   "e": 36.403
  },
  {
   "text": "des boules de c\u00e9ramique, tass\u00e9es entre les pierres et les briques.",
   "s": 37.239,
   "e": 41.04
  },
  {
   "text": "Les rayons X les ouvrent sans les casser :",
   "s": 41.895,
   "e": 44.13
  },
  {
   "text": "de la poudre noire,",
   "s": 44.261,
   "e": 45.512
  },
  {
   "text": "et des \u00e9clats de fer.",
   "s": 46.381,
   "e": 47.884
  },
  {
   "text": "Les Mongols lan\u00e7aient bien du tonnerre sur les samoura\u00efs.",
   "s": 48.604,
   "e": 51.295
  },
  {
   "text": "Le dessin \u00e9tait faux\u2026 mais la bombe,",
   "s": 52.11,
   "e": 54.596
  },
  {
   "text": "elle,",
   "s": 55.441,
   "e": 56.092
  },
  {
   "text": "\u00e9tait bien r\u00e9elle.",
   "s": 56.67,
   "e": 58.911
  }
 ]
