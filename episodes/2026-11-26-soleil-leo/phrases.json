 "phrases": [
  {
   "text": "L\u00e9o a une nuit pour coudre un costume de soleil.",
   "s": 0.0,
   "e": 2.26
  },
  {
   "text": "Il ne sait pas coudre.",
   "s": 2.64,
   "e": 3.42
  },
  {
   "text": "Demain,",
   "s": 4.16,
   "e": 4.46
  },
  {
   "text": "sa petite s\u0153ur Lila joue le soleil \u00e0 la f\u00eate de l'\u00e9cole.",
   "s": 4.58,
   "e": 7.52
  },
  {
   "text": "Il pique l'aiguille,",
   "s": 7.52,
   "e": 8.3
  },
  {
   "text": "et il se pique le doigt.",
   "s": 8.3,
   "e": 9.36
  },
  {
   "text": "Il tire le fil,",
   "s": 9.82,
   "e": 10.42
  },
  {
   "text": "et le tissu se d\u00e9chire.",
   "s": 10.42,
   "e": 11.58
  },
  {
   "text": "\u00c0 minuit,",
   "s": 12.44,
   "e": 12.82
  },
  {
   "text": "les rayons jaunes sont tout de travers,",
   "s": 12.92,
   "e": 14.54
  },
  {
   "text": "et l'un d'eux tombe par terre.",
   "s": 14.54,
   "e": 15.62
  },
  {
   "text": "L\u00e9o veut tout abandonner.",
   "s": 16.58,
   "e": 17.6
  },
  {
   "text": "Mais sur le lit,",
   "s": 18.34,
   "e": 18.84
  },
  {
   "text": "Lila dort,",
   "s": 19.36,
   "e": 19.84
  },
  {
   "text": "sa peluche serr\u00e9e contre elle.",
   "s": 19.84,
   "e": 21.3
  },
  {
   "text": "Alors il reprend l'aiguille,",
   "s": 21.98,
   "e": 23.36
  },
  {
   "text": "un point apr\u00e8s l'autre,",
   "s": 23.36,
   "e": 24.27
  },
  {
   "text": "jusqu'au lever du jour.",
   "s": 24.27,
   "e": 25.06
  },
  {
   "text": "Sur la sc\u00e8ne,",
   "s": 25.82,
   "e": 26.64
  },
  {
   "text": "Lila entre.",
   "s": 27.04,
   "e": 27.6
  },
  {
   "text": "Le costume penche,",
   "s": 28.32,
   "e": 29.38
  },
  {
   "text": "un rayon pend,",
   "s": 29.54,
   "e": 30.16
  },
  {
   "text": "et les enfants rigolent.",
   "s": 30.16,
   "e": 31.24
  },
  {
   "text": "Au fond de la salle,",
   "s": 32.02,
   "e": 32.72
  },
  {
   "text": "L\u00e9o serre les poings.",
   "s": 32.94,
   "e": 34.62
  },
  {
   "text": "Sauf que Lila l\u00e8ve les bras et tourne sur elle-m\u00eame.",
   "s": 34.62,
   "e": 37.44
  },
  {
   "text": "Tous les rayons ondulent,",
   "s": 37.44,
   "e": 38.6
  },
  {
   "text": "comme un vrai soleil qui danse.",
   "s": 38.6,
   "e": 40.1
  },
  {
   "text": "La salle applaudit debout.",
   "s": 40.68,
   "e": 41.64
  },
  {
   "text": "Lila crie :",
   "s": 42.3,
   "e": 43.01
  },
  {
   "text": "\u00ab C'est mon grand fr\u00e8re qui l'a cousu !",
   "s": 43.01,
   "e": 44.84
  },
  {
   "text": "\u00bb L\u00e9o rougit et sourit,",
   "s": 44.84,
   "e": 46.66
  },
  {
   "text": "le doigt couvert de pansements.",
   "s": 46.92,
   "e": 48.9
  },
  {
   "text": "Ce qu'on fait de travers pour quelqu'un vaut mieux que le parfait qu'on n'ose pas commencer.",
   "s": 48.9,
   "e": 52.1
  },
  {
   "text": "La prochaine fois que tu h\u00e9sites,",
   "s": 52.78,
   "e": 54.0
  },
  {
   "text": "prends l'aiguille.",
   "s": 54.36,
   "e": 54.82
  }
 ]
}