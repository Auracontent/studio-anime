 "phrases": [
  {
   "text": "Cet archet dessine des formes parfaites dans le sable\u2026 sans jamais le toucher.",
   "s": 0.0,
   "e": 4.54
  },
  {
   "text": "Un physicien allemand,",
   "s": 5.48,
   "e": 6.34
  },
  {
   "text": "Ernst Chladni,",
   "s": 6.5,
   "e": 7.63
  },
  {
   "text": "saupoudre de sable une plaque de m\u00e9tal.",
   "s": 7.63,
   "e": 9.5
  },
  {
   "text": "Puis il frotte son bord avec un archet.",
   "s": 9.98,
   "e": 12.74
  },
  {
   "text": "Le sable saute,",
   "s": 12.74,
   "e": 13.52
  },
  {
   "text": "danse,",
   "s": 14.18,
   "e": 14.62
  },
  {
   "text": "et se range tout seul en \u00e9toile.",
   "s": 14.62,
   "e": 17.34
  },
  {
   "text": "Une autre note,",
   "s": 17.34,
   "e": 18.0
  },
  {
   "text": "une autre figure.",
   "s": 18.56,
   "e": 19.1
  },
  {
   "text": "En mille huit cent neuf,",
   "s": 20.2,
   "e": 21.26
  },
  {
   "text": "il montre \u00e7a \u00e0 Paris.",
   "s": 21.26,
   "e": 22.04
  },
  {
   "text": "Napol\u00e9on est fascin\u00e9.",
   "s": 22.62,
   "e": 23.58
  },
  {
   "text": "Alors l'Acad\u00e9mie des sciences lance un d\u00e9fi :",
   "s": 24.1,
   "e": 26.193
  },
  {
   "text": "trois mille francs pour qui expliquera ces dessins.",
   "s": 26.193,
   "e": 28.78
  },
  {
   "text": "Sauf que personne n'y arrive.",
   "s": 29.26,
   "e": 30.44
  },
  {
   "text": "Les plus grands savants de France s\u00e8chent.",
   "s": 30.94,
   "e": 33.22
  },
  {
   "text": "Une seule personne s'y attaque :",
   "s": 33.22,
   "e": 34.74
  },
  {
   "text": "Sophie Germain.",
   "s": 34.74,
   "e": 35.52
  },
  {
   "text": "Une femme,",
   "s": 36.2,
   "e": 36.62
  },
  {
   "text": "qui n'a m\u00eame pas le droit d'\u00e9tudier \u00e0 l'universit\u00e9.",
   "s": 37.08,
   "e": 39.78
  },
  {
   "text": "Elle apprend les math\u00e9matiques seule,",
   "s": 39.78,
   "e": 41.1
  },
  {
   "text": "chez elle,",
   "s": 41.1,
   "e": 41.76
  },
  {
   "text": "\u00e0 la bougie.",
   "s": 42.2,
   "e": 42.62
  },
  {
   "text": "Sa premi\u00e8re tentative \u00e9choue.",
   "s": 43.34,
   "e": 44.28
  },
  {
   "text": "La deuxi\u00e8me aussi.",
   "s": 45.06,
   "e": 45.62
  },
  {
   "text": "Les juges la refusent encore.",
   "s": 46.38,
   "e": 47.36
  },
  {
   "text": "Mais elle refait ses calculs,",
   "s": 48.04,
   "e": 49.64
  },
  {
   "text": "une troisi\u00e8me fois,",
   "s": 49.64,
   "e": 50.6
  },
  {
   "text": "et elle ne l\u00e2che rien.",
   "s": 51.06,
   "e": 52.12
  },
  {
   "text": "En mille huit cent seize,",
   "s": 52.92,
   "e": 54.268
  },
  {
   "text": "l'Acad\u00e9mie lui remet enfin le prix.",
   "s": 54.268,
   "e": 55.58
  },
  {
   "text": "C'est la premi\u00e8re femme \u00e0 gagner un prix de l'Acad\u00e9mie.",
   "s": 55.58,
   "e": 59.08
  },
  {
   "text": "Sa th\u00e9orie sur les plaques qui vibrent sert encore aux ing\u00e9nieurs.",
   "s": 59.08,
   "e": 61.82
  },
  {
   "text": "Alors la prochaine fois qu'on te dit que tu n'as pas ta place\u2026 regarde cet archet :",
   "s": 62.58,
   "e": 66.76
  },
  {
   "text": "le sable se range,",
   "s": 66.76,
   "e": 67.66
  },
  {
   "text": "note apr\u00e8s note.",
   "s": 68.28,
   "e": 69.3
  }
 ]
