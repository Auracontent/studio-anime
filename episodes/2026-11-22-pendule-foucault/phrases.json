 "phrases": [
  {
   "text": "Ce boulet qui se balance sans rien toucher prouve que la Terre tourne.",
   "s": 0.0,
   "e": 4.22
  },
  {
   "text": "Paris,",
   "s": 4.6,
   "e": 4.92
  },
  {
   "text": "mille huit cent cinquante et un.",
   "s": 4.92,
   "e": 7.02
  },
  {
   "text": "L\u00e9on Foucault accroche une boule de vingt-huit kilos au plafond du Panth\u00e9on,",
   "s": 7.02,
   "e": 10.26
  },
  {
   "text": "au bout d'un fil de soixante-sept m\u00e8tres.",
   "s": 10.26,
   "e": 12.26
  },
  {
   "text": "Il la lance doucement.",
   "s": 12.92,
   "e": 13.82
  },
  {
   "text": "Une pointe,",
   "s": 14.54,
   "e": 15.24
  },
  {
   "text": "sous la boule,",
   "s": 15.24,
   "e": 15.94
  },
  {
   "text": "trace un trait dans le sable.",
   "s": 15.94,
   "e": 17.54
  },
  {
   "text": "Le public attend.",
   "s": 18.34,
   "e": 19.06
  },
  {
   "text": "Les minutes passent.",
   "s": 20.1,
   "e": 20.94
  },
  {
   "text": "Et le trait change de direction.",
   "s": 21.56,
   "e": 23.28
  },
  {
   "text": "Personne n'a touch\u00e9 la boule.",
   "s": 24.16,
   "e": 25.36
  },
  {
   "text": "Elle balance toujours dans le m\u00eame sens.",
   "s": 26.04,
   "e": 27.52
  },
  {
   "text": "C'est le sol qui tourne.",
   "s": 27.52,
   "e": 29.76
  },
  {
   "text": "Chaque heure,",
   "s": 30.34,
   "e": 31.12
  },
  {
   "text": "le trait d\u00e9vie de onze degr\u00e9s.",
   "s": 31.46,
   "e": 33.04
  },
  {
   "text": "En trente-deux heures,",
   "s": 33.58,
   "e": 34.56
  },
  {
   "text": "le tour est complet.",
   "s": 34.92,
   "e": 35.5
  },
  {
   "text": "Les Parisiens,",
   "s": 36.56,
   "e": 37.22
  },
  {
   "text": "bouche b\u00e9e,",
   "s": 37.5,
   "e": 38.34
  },
  {
   "text": "sentent la Terre tourner sous leurs pieds.",
   "s": 38.34,
   "e": 40.52
  },
  {
   "text": "Alors,",
   "s": 41.02,
   "e": 41.22
  },
  {
   "text": "ce boulet qui se balance sans rien toucher\u2026 c'est toi qui bouges.",
   "s": 41.78,
   "e": 45.22
  }
 ]
}