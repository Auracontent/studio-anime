 "phrases": [
  {
   "text": "Deux bo\u00eetes p\u00e8sent exactement pareil,",
   "s": 0.241,
   "e": 1.797
  },
  {
   "text": "et pourtant,",
   "s": 1.953,
   "e": 3.235
  },
  {
   "text": "ta main jure que la petite est plus lourde.",
   "s": 3.604,
   "e": 6.209
  },
  {
   "text": "Un m\u00e9decin fran\u00e7ais l'a prouv\u00e9,",
   "s": 6.726,
   "e": 7.808
  },
  {
   "text": "\u00e0 Nancy,",
   "s": 8.019,
   "e": 8.497
  },
  {
   "text": "en mille huit cent quatre-vingt-onze.",
   "s": 8.681,
   "e": 9.912
  },
  {
   "text": "Il fabrique des boules de m\u00eame poids,",
   "s": 10.323,
   "e": 11.804
  },
  {
   "text": "mais de tailles diff\u00e9rentes.",
   "s": 12.151,
   "e": 13.094
  },
  {
   "text": "Il les tend \u00e0 ses volontaires :",
   "s": 13.627,
   "e": 14.913
  },
  {
   "text": "laquelle est la plus lourde ?",
   "s": 15.225,
   "e": 16.195
  },
  {
   "text": "\u00c0 chaque fois, m\u00eame r\u00e9ponse :",
   "s": 17.096,
   "e": 17.941
  },
  {
   "text": "la petite !",
   "s": 18.098,
   "e": 19.035
  },
  {
   "text": "Ils soup\u00e8sent,",
   "s": 19.417,
   "e": 19.957
  },
  {
   "text": "recommencent, et se trompent encore. Sauf que\u2026 la balance,",
   "s": 20.414,
   "e": 22.762
  },
  {
   "text": "elle,",
   "s": 23.092,
   "e": 23.351
  },
  {
   "text": "ne ment pas :",
   "s": 23.924,
   "e": 24.834
  },
  {
   "text": "\u00e9galit\u00e9 parfaite.",
   "s": 25.185,
   "e": 25.682
  },
  {
   "text": "En fait,",
   "s": 26.225,
   "e": 27.168
  },
  {
   "text": "ton cerveau devine le poids avant de soulever :",
   "s": 28.032,
   "e": 30.6
  },
  {
   "text": "gros,",
   "s": 30.999,
   "e": 31.314
  },
  {
   "text": "donc lourd.",
   "s": 31.518,
   "e": 32.008
  },
  {
   "text": "Il pr\u00e9pare trop d'effort pour la grosse,",
   "s": 32.437,
   "e": 33.854
  },
  {
   "text": "trop peu pour la petite,",
   "s": 34.133,
   "e": 35.074
  },
  {
   "text": "et cet \u00e9cart te trompe.",
   "s": 35.536,
   "e": 36.692
  },
  {
   "text": "M\u00eame quand on le sait,",
   "s": 37.278,
   "e": 38.087
  },
  {
   "text": "l'illusion reste.",
   "s": 38.474,
   "e": 39.221
  },
  {
   "text": "Alors m\u00e9fie-toi de ta main :",
   "s": 40.049,
   "e": 41.027
  },
  {
   "text": "deux bo\u00eetes,",
   "s": 41.519,
   "e": 42.024
  },
  {
   "text": "un seul poids,",
   "s": 42.528,
   "e": 43.092
  },
  {
   "text": "et une petite menteuse.",
   "s": 43.609,
   "e": 44.629
  }
 ]
