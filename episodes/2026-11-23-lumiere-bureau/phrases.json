 "phrases": [
  {
   "text": "Tous les matins,",
   "s": 0.0,
   "e": 0.82
  },
  {
   "text": "avant tout le monde,",
   "s": 1.02,
   "e": 1.74
  },
  {
   "text": "quelqu'un allume les lumi\u00e8res du bureau.",
   "s": 1.74,
   "e": 3.16
  },
  {
   "text": "C'est Karim.",
   "s": 3.16,
   "e": 4.04
  },
  {
   "text": "Il lance la cafeti\u00e8re,",
   "s": 4.54,
   "e": 5.48
  },
  {
   "text": "arrose la plante et d\u00e9bloque l'imprimante.",
   "s": 5.48,
   "e": 8.52
  },
  {
   "text": "Personne ne dit merci.",
   "s": 8.52,
   "e": 9.36
  },
  {
   "text": "Pire,",
   "s": 9.82,
   "e": 10.04
  },
  {
   "text": "on se moque de lui,",
   "s": 10.32,
   "e": 11.04
  },
  {
   "text": "parce qu'il arrive trop t\u00f4t.",
   "s": 11.04,
   "e": 12.04
  },
  {
   "text": "Un lundi,",
   "s": 12.62,
   "e": 13.06
  },
  {
   "text": "Karim est malade.",
   "s": 13.3,
   "e": 14.0
  },
  {
   "text": "Il ne vient pas.",
   "s": 14.26,
   "e": 14.7
  },
  {
   "text": "Le bureau reste sombre et glac\u00e9.",
   "s": 15.54,
   "e": 17.44
  },
  {
   "text": "Le caf\u00e9 est froid,",
   "s": 17.9,
   "e": 18.6
  },
  {
   "text": "la plante penche,",
   "s": 19.0,
   "e": 19.88
  },
  {
   "text": "l'imprimante grince.",
   "s": 19.88,
   "e": 21.06
  },
  {
   "text": "Sauf que L\u00e9a,",
   "s": 21.7,
   "e": 22.32
  },
  {
   "text": "la cheffe,",
   "s": 22.5,
   "e": 23.0
  },
  {
   "text": "comprend.",
   "s": 23.0,
   "e": 23.16
  },
  {
   "text": "Elle repense \u00e0 cette lumi\u00e8re,",
   "s": 23.74,
   "e": 24.8
  },
  {
   "text": "allum\u00e9e chaque matin,",
   "s": 25.24,
   "e": 26.12
  },
  {
   "text": "depuis des ann\u00e9es.",
   "s": 26.12,
   "e": 26.86
  },
  {
   "text": "Le lendemain,",
   "s": 27.5,
   "e": 28.22
  },
  {
   "text": "elle arrive \u00e0 six heures,",
   "s": 28.34,
   "e": 29.52
  },
  {
   "text": "allume les lumi\u00e8res et pose un caf\u00e9 sur son bureau.",
   "s": 29.9,
   "e": 32.04
  },
  {
   "text": "Ce que tu fais en silence,",
   "s": 33.06,
   "e": 34.16
  },
  {
   "text": "on ne le voit qu'une fois que tu t'arr\u00eates.",
   "s": 34.54,
   "e": 36.44
  },
  {
   "text": "Alors,",
   "s": 36.44,
   "e": 36.62
  },
  {
   "text": "aujourd'hui,",
   "s": 36.62,
   "e": 37.74
  },
  {
   "text": "allume une lumi\u00e8re pour quelqu'un.",
   "s": 37.74,
   "e": 38.9
  }
 ]
